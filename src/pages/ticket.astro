---
// src/pages/ticket.astro - Direct Pure PDF Document Viewer
---

<!DOCTYPE html>
<html lang="nl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>E-Ticket PDF | Whisky Fest Amsterdam 2026</title>
  <meta name="robots" content="noindex, nofollow">
  <!-- jsPDF & QRCode libs for authentic vector PDF generation -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>

  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    html, body { width: 100%; height: 100%; overflow: hidden; background: #323639; }
    #pdf-frame { width: 100%; height: 100%; border: none; display: block; }
    #loading-screen {
      position: fixed; inset: 0; background: #1D1C1A; color: #FAF7F2;
      display: flex; flex-direction: column; align-items: center; justify-content: center;
      font-family: system-ui, -apple-system, sans-serif; gap: 1rem; z-index: 10;
    }
    .spinner {
      width: 36px; height: 36px; border: 3px solid rgba(255,255,255,0.15);
      border-top-color: #C58B39; border-radius: 50%; animation: spin 0.8s linear infinite;
    }
    @keyframes spin { to { transform: rotate(360deg); } }
  </style>
</head>
<body>
  <div id="loading-screen">
    <div class="spinner"></div>
    <p style="font-size: 0.95rem; font-weight: 700; letter-spacing: 0.08em; color: #C58B39;">E-TICKET PDF DOCUMENT LADEN...</p>
  </div>

  <div id="qrcode-container" style="display:none;"></div>
  <iframe id="pdf-frame" title="Officiëel E-Ticket PDF Document"></iframe>

  <script>
    window.addEventListener('DOMContentLoaded', async () => {
      const params = new URLSearchParams(window.location.search);
      let code = params.get('id') || params.get('code') || 'WF-2026-84387-1';
      if (!code.startsWith('#')) code = '#' + code;
      const title = params.get('title') || 'VIP Sessie - Vrijdag';
      const name = params.get('name') || 'Deon Draijer';
      const time = params.get('time') || '13:00 - 17:00 UUR';
      const festival = 'Whisky Fest Amsterdam 2026';
      const venue = 'De Kromhouthal Amsterdam';
      const address = 'Gedempt Hamerkanaal 231, 1021 KP Amsterdam';

      // Generate QR Code
      const qrDiv = document.getElementById('qrcode-container');
      const qr = new QRCode(qrDiv, {
        text: `TICKET:${code}|${name}|${title}`,
        width: 240,
        height: 240,
        correctLevel: QRCode.CorrectLevel.H
      });

      setTimeout(() => {
        const qrCanvas = qrDiv.querySelector('canvas');
        const qrDataUrl = qrCanvas ? qrCanvas.toDataURL('image/png') : '';

        const { jsPDF } = (window as any).jspdf;
        // Landscape A4 Vector Ticket (297 x 210 mm)
        const doc = new jsPDF({
          orientation: 'landscape',
          unit: 'mm',
          format: 'a4'
        });

        // 1. Warm Parchment Background
        doc.setFillColor(250, 247, 242);
        doc.rect(0, 0, 297, 210, 'F');

        // 2. Ticket Frame
        doc.setDrawColor(29, 28, 26);
        doc.setLineWidth(1.4);
        doc.roundedRect(15, 15, 267, 180, 4, 4, 'S');

        // Inner Gold Border
        doc.setDrawColor(197, 139, 57);
        doc.setLineWidth(0.5);
        doc.roundedRect(17, 17, 263, 176, 3, 3, 'S');

        // 3. Header Bar
        doc.setFillColor(29, 28, 26);
        doc.rect(17, 17, 263, 26, 'F');

        doc.setTextColor(250, 247, 242);
        doc.setFont('helvetica', 'bold');
        doc.setFontSize(16);
        doc.text(festival.toUpperCase(), 25, 33);

        doc.setTextColor(197, 139, 57);
        doc.setFontSize(10);
        doc.text('OFFICIEEL TOEGANGSBEWIJS • EST. 2004', 210, 33);

        // 4. Perforation Stub Divider (Dashed)
        doc.setDrawColor(29, 28, 26);
        doc.setLineDashPattern([2, 2], 0);
        doc.line(205, 43, 205, 193);
        doc.setLineDashPattern([], 0);

        // 5. Main Body
        doc.setTextColor(29, 28, 26);
        doc.setFont('helvetica', 'bold');
        doc.setFontSize(22);
        doc.text(title, 25, 62);

        // Gold divider
        doc.setFillColor(197, 139, 57);
        doc.rect(25, 68, 165, 1.2, 'F');

        // Meta grid
        doc.setFontSize(9);
        doc.setTextColor(110, 104, 95);
        doc.setFont('helvetica', 'bold');
        doc.text('KAARTHOUDER', 25, 82);
        doc.text('STATUS', 115, 82);

        doc.setFontSize(13);
        doc.setTextColor(29, 28, 26);
        doc.text(name, 25, 90);

        doc.setTextColor(30, 107, 72);
        doc.text('GELDIG TOEGANGSBEWIJS', 115, 90);

        doc.setFontSize(9);
        doc.setTextColor(110, 104, 95);
        doc.text('TIJDSSLOT', 25, 108);
        doc.text('TICKET CODE', 115, 108);

        doc.setFontSize(13);
        doc.setTextColor(29, 28, 26);
        doc.text(time, 25, 116);

        doc.setTextColor(227, 6, 19);
        doc.text(code, 115, 116);

        doc.setFontSize(9);
        doc.setTextColor(110, 104, 95);
        doc.text('LOCATIE & ADRES', 25, 134);

        doc.setFontSize(11);
        doc.setTextColor(29, 28, 26);
        doc.text(`${venue} • ${address}`, 25, 142);

        // Disclaimer
        doc.setFontSize(8);
        doc.setTextColor(110, 104, 95);
        doc.setFont('helvetica', 'italic');
        doc.text('* Toegang 18+. Toon deze QR-code digitaal op uw smartphone of uitgeprint bij de entree.', 25, 178);

        // 6. QR Scanner Stub
        doc.setFont('helvetica', 'bold');
        doc.setFontSize(8);
        doc.setTextColor(110, 104, 95);
        doc.text('SCAN & CONTROLE STUB', 215, 56);

        if (qrDataUrl) {
          doc.addImage(qrDataUrl, 'PNG', 215, 65, 55, 55);
        }

        doc.setFontSize(10);
        doc.setTextColor(29, 28, 26);
        doc.text('SCAN BIJ DE DEUR', 222, 132);

        doc.setFontSize(11);
        doc.setTextColor(227, 6, 19);
        doc.text(code, 222, 142);

        // Output real PDF Blob into browser viewer
        const pdfBlob = doc.output('blob');
        const blobUrl = URL.createObjectURL(pdfBlob);
        
        const frame = document.getElementById('pdf-frame');
        if (frame) (frame as HTMLIFrameElement).src = blobUrl;

        const loading = document.getElementById('loading-screen');
        if (loading) loading.style.display = 'none';

      }, 150);
    });
  </script>
</body>
</html>
