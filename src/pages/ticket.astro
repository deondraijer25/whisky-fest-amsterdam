---
// src/pages/ticket.astro - 1-op-1 hetzelfde design als in Mijn Account
import '../styles/global.css';
---

<!DOCTYPE html>
<html lang="nl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>E-Ticket | Whisky Fest Amsterdam</title>
  <meta name="robots" content="noindex, nofollow">
  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@600;700;800;900&family=Playfair+Display:ital,wght@0,600;0,700;0,800;1,600&family=Plus+Jakarta+Sans:wght@500;600;700;800&family=Poppins:wght@400;500;600;700;800&family=Unbounded:wght@600;700;800;900&display=swap" rel="stylesheet">

  <style>
    :root {
      --bg-parchment: #F9F6F0;
      --bg-paper-card: #FAF7F2;
      --bg-sand: #F0ECE1;
      --text-charcoal: #1D1C1A;
      --text-muted: #736C62;
      --whisky-gold: #C58B39;
      --whisky-gold-dark: #8C6E46;
      --border-color-dark: #1D1C1A;
      --brand-red: #E30613;
      --font-display: 'Unbounded', 'Cinzel', system-ui, sans-serif;
      --font-sans: 'Plus Jakarta Sans', 'Poppins', system-ui, sans-serif;
      --font-serif: 'Playfair Display', serif;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html, body {
      min-height: 100vh;
      width: 100%;
      background-color: var(--bg-parchment);
      font-family: var(--font-sans);
      color: var(--text-charcoal);
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 2.5rem 1rem;
    }

    /* Outer Wrapper - Perfectly Centered in Screen */
    .ticket-page-wrapper {
      width: 100%;
      max-width: 820px;
      margin: auto;
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }

    /* TOP ACTION BUTTONS ROW (No icons/logos on left, clean alignment) */
    .ticket-top-actions {
      display: flex;
      justify-content: flex-end;
      align-items: center;
      gap: 0.75rem;
      width: 100%;
      padding-bottom: 0.25rem;
    }

    .btn-ticket-nav {
      font-family: var(--font-sans);
      font-size: 0.82rem;
      font-weight: 800;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      padding: 0.65rem 1.25rem;
      border-radius: 4px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.55rem;
      cursor: pointer;
      text-decoration: none;
      transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
      box-shadow: 3px 3px 0px var(--text-charcoal);
      line-height: 1.2;
      border: 2px solid var(--text-charcoal);
      height: auto;
      white-space: nowrap;
    }

    .btn-nav-download {
      background-color: var(--brand-red);
      color: #FFFFFF !important;
    }

    .btn-nav-download:hover {
      transform: translateY(-2px);
      box-shadow: 4px 4px 0px var(--text-charcoal);
      filter: brightness(1.1);
    }

    .btn-nav-account {
      background-color: #FFFFFF;
      color: var(--text-charcoal) !important;
    }

    .btn-nav-account:hover {
      background-color: var(--bg-sand);
      transform: translateY(-2px);
      box-shadow: 4px 4px 0px var(--text-charcoal);
    }

    /* 1-OP-1 TICKET ENVELOPE CARD FROM MIJN ACCOUNT */
    .ticket-envelope {
      display: flex;
      flex-direction: column;
      width: 100%;
    }

    .ticket-stub-large {
      background-color: var(--bg-paper-card);
      border: 2px solid var(--text-charcoal);
      border-radius: 10px;
      display: grid;
      grid-template-columns: 240px 1fr;
      box-shadow: 0 12px 35px rgba(0,0,0,0.06), 6px 6px 0px var(--text-charcoal);
      overflow: hidden;
      position: relative;
    }

    .ticket-right-stub {
      background-color: var(--bg-sand);
      border-right: 2px dashed var(--border-color-dark);
      padding: 2rem 1.5rem;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
    }

    .scan-label {
      font-family: var(--font-sans);
      font-weight: 800;
      font-size: 0.7rem;
      letter-spacing: 0.12em;
      color: var(--text-muted);
      margin-bottom: 1rem;
      text-transform: uppercase;
    }

    .qr-code-holder {
      background-color: #ffffff;
      border: 2px solid var(--text-charcoal);
      padding: 0.85rem;
      border-radius: 6px;
      margin-bottom: 0.85rem;
      display: inline-block;
    }

    .scan-instructions {
      font-family: var(--font-sans);
      font-weight: 800;
      font-size: 0.75rem;
      letter-spacing: 0.05em;
      color: var(--whisky-gold-dark);
      text-transform: uppercase;
    }

    .scan-res-hash {
      font-family: var(--font-sans);
      font-weight: 700;
      font-size: 0.85rem;
      color: var(--text-charcoal);
      margin-top: 2px;
    }

    .ticket-left-stub {
      padding: 2rem 2.25rem;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      position: relative;
    }

    .ticket-watermark {
      position: absolute;
      right: 2rem;
      bottom: 1rem;
      font-family: var(--font-display);
      font-size: 7rem;
      color: rgba(0, 100, 72, 0.04);
      pointer-events: none;
      line-height: 1;
      font-weight: 900;
      user-select: none;
    }

    .ticket-stub-header {
      display: flex;
      align-items: center;
      gap: 1.25rem;
    }

    .ticket-stub-date-badge {
      background-color: var(--text-charcoal);
      color: var(--whisky-gold);
      border-radius: 6px;
      padding: 0.4rem 0.85rem;
      display: flex;
      flex-direction: column;
      align-items: center;
      min-width: 54px;
      line-height: 1;
    }

    .badge-month {
      font-family: var(--font-sans);
      font-size: 0.65rem;
      font-weight: 800;
      letter-spacing: 0.1em;
      text-transform: uppercase;
    }

    .badge-day {
      font-family: var(--font-display);
      font-size: 1.5rem;
      line-height: 1;
      color: #FFFFFF;
      margin-top: 2px;
    }

    .ticket-stub-org {
      display: flex;
      flex-direction: column;
    }

    .org-established {
      font-family: var(--font-sans);
      font-size: 0.65rem;
      font-weight: 800;
      color: var(--whisky-gold-dark);
      letter-spacing: 0.1em;
      text-transform: uppercase;
    }

    .org-name {
      font-family: var(--font-sans);
      font-size: 0.95rem;
      font-weight: 800;
      color: var(--text-charcoal);
    }

    .org-location {
      font-family: var(--font-serif);
      font-size: 0.8rem;
      color: var(--text-muted);
    }

    .vintage-divider {
      border-bottom: 1px dashed var(--border-color-dark);
      margin: 1.25rem 0;
    }

    .ticket-session-title {
      font-family: var(--font-display);
      font-size: 1.85rem;
      color: var(--text-charcoal);
      margin: 0 0 1rem;
      line-height: 1.15;
      font-weight: 800;
      text-transform: uppercase;
    }

    .ticket-meta-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0.85rem 1.5rem;
    }

    .meta-item {
      display: flex;
      flex-direction: column;
      gap: 2px;
    }

    .meta-label {
      font-family: var(--font-sans);
      font-size: 0.65rem;
      font-weight: 800;
      letter-spacing: 0.08em;
      color: var(--text-muted);
      text-transform: uppercase;
    }

    .meta-value {
      font-family: var(--font-sans);
      font-size: 0.9rem;
      font-weight: 700;
      color: var(--text-charcoal);
    }

    .meta-value.status-highlight {
      color: var(--brand-red);
      font-weight: 800;
    }

    .meta-value.code-highlight {
      color: var(--brand-red);
      font-weight: 800;
    }

    .ticket-stub-footer {
      margin-top: 1.25rem;
      border-top: 1px solid #E8E0D2;
      padding-top: 0.75rem;
    }

    .stub-disclaimer {
      font-family: var(--font-serif);
      font-size: 0.75rem;
      color: var(--text-muted);
      font-style: italic;
    }

    .ticket-tip-bottom {
      text-align: center;
      font-size: 0.82rem;
      color: var(--text-muted);
      margin-top: 0.5rem;
    }

    @media (max-width: 768px) {
      .ticket-stub-large {
        grid-template-columns: 1fr;
      }
      .ticket-right-stub {
        border-right: none;
        border-bottom: 2px dashed var(--border-color-dark);
        padding: 1.5rem;
      }
      .ticket-left-stub {
        padding: 1.5rem;
      }
      .ticket-session-title {
        font-size: 1.45rem;
      }
      .ticket-meta-grid {
        grid-template-columns: 1fr;
      }
      .ticket-top-actions {
        justify-content: stretch;
      }
      .btn-ticket-nav {
        flex: 1;
      }
    }

    @media print {
      body {
        background: white !important;
        color: black !important;
        padding: 0 !important;
      }
      .ticket-top-actions, .ticket-tip-bottom {
        display: none !important;
      }
      .ticket-page-wrapper {
        max-width: 100% !important;
        margin: 0 !important;
        padding: 0 !important;
      }
      .ticket-envelope {
        border: none !important;
        box-shadow: none !important;
        margin: 0 !important;
      }
      .ticket-stub-large {
        border: 1.5px solid #1D1C1A !important;
        box-shadow: none !important;
        background: white !important;
        color: black !important;
        page-break-inside: avoid;
      }
      .ticket-left-stub, .ticket-right-stub {
        background: white !important;
        color: black !important;
      }
      .ticket-watermark {
        color: rgba(29, 28, 26, 0.04) !important;
      }
    }
  </style>
</head>
<body>
  <div class="ticket-page-wrapper">
    <!-- Top Action Buttons Row -->
    <div class="ticket-top-actions">
      <button type="button" class="btn-ticket-nav btn-nav-download" onclick="window.print()">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
          <polyline points="7 10 12 15 17 10"/>
          <line x1="12" y1="15" x2="12" y2="3"/>
        </svg>
        Download E-Ticket (PDF)
      </button>
      <a href="/account" class="btn-ticket-nav btn-nav-account">
        Mijn Account
      </a>
    </div>

    <!-- 1-op-1 Exact Ticket Stub from Mijn Account -->
    <div class="ticket-envelope">
      <div class="ticket-stub-large">
        <!-- QR Code & Scanner stub (Left) -->
        <div class="ticket-right-stub">
          <span class="scan-label">CONTROLE STUB</span>
          
          <div class="qr-code-holder">
            <svg width="110" height="110" viewBox="0 0 100 100" style="shape-rendering: crispedges; display:block;">
              <path d="M0,0 h30 v10 h-20 v20 h-10 z" fill="#1D1C1A"/>
              <path d="M10,10 h10 v10 h-10 z" fill="#1D1C1A"/>
              <path d="M70,0 h30 v30 h-10 v-20 h-20 z" fill="#1D1C1A"/>
              <path d="M80,10 h10 v10 h-10 z" fill="#1D1C1A"/>
              <path d="M0,70 h10 v20 h20 v10 h-30 z" fill="#1D1C1A"/>
              <path d="M10,80 h10 v10 h-10 z" fill="#1D1C1A"/>
              <path d="M45,45 h10 v10 h-10 z" fill="#E30613"/>
              <path d="M30,30 h10 v5 h-10 z M35,40 h15 v5 h-15 z M55,30 h10 v10 h-5 v-5 h-5 z" fill="#1D1C1A"/>
              <path d="M70,70 h30 v10 h-10 v10 h-20 z M80,80 h10 v10 h-10 z" fill="#1D1C1A"/>
              <path d="M40,65 h10 v10 h-10 z M55,60 h10 v5 h-10 z M60,75 h5 v15 h-5 z" fill="#1D1C1A"/>
              <path d="M65,45 h10 v5 h-10 z M30,55 h5 v15 h-5 z M45,85 h10 v5 h-10 z" fill="#1D1C1A"/>
            </svg>
          </div>

          <span class="scan-instructions">SCAN BIJ DE DEUR</span>
          <span class="scan-res-hash" id="tv-code">#WF-2026-84387-1</span>
        </div>

        <!-- Session & Holder details (Right) -->
        <div class="ticket-left-stub">
          <div class="ticket-watermark" id="tv-watermark">WF</div>
          
          <div class="ticket-stub-header">
            <div class="ticket-stub-date-badge">
              <span class="badge-month" id="tv-month">NOV</span>
              <span class="badge-day" id="tv-day">13</span>
            </div>
            <div class="ticket-stub-org">
              <span class="org-established">Est. 2004</span>
              <span class="org-name" id="tv-org">Whisky Fest Amsterdam</span>
              <span class="org-location" id="tv-loc">De Kromhouthal, Amsterdam</span>
            </div>
          </div>

          <div class="vintage-divider"></div>

          <div class="ticket-stub-body">
            <h2 class="ticket-session-title" id="tv-session-title">VIP SESSIE - VRIJDAG</h2>
            
            <div class="ticket-meta-grid">
              <div class="meta-item">
                <span class="meta-label">KAARTHOUDER:</span>
                <strong class="meta-value" id="tv-name">Deon Draijer</strong>
              </div>
              <div class="meta-item">
                <span class="meta-label">STATUS:</span>
                <strong class="meta-value status-highlight">GELDIG TOEGANGSBEWIJS</strong>
              </div>
              <div class="meta-item">
                <span class="meta-label">TIJDSSLOT:</span>
                <strong class="meta-value" id="tv-time">13:00 – 17:00 UUR</strong>
              </div>
              <div class="meta-item">
                <span class="meta-label">TICKET CODE:</span>
                <strong class="meta-value code-highlight" id="tv-ticket-code">#WF-2026-84387-1</strong>
              </div>
            </div>

            <div class="ticket-stub-footer">
              <p class="stub-disclaimer">* Toegang uitsluitend voor personen van 18 jaar en ouder. Legitimatie verplicht bij de deur.</p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <p class="ticket-tip-bottom">
      💡 U kunt dit e-ticket direct op uw smartphone bewaren of tonen bij de entree.
    </p>
  </div>

  <script>
    const params = new URLSearchParams(window.location.search);
    let code = params.get('id') || params.get('code') || 'WF-2026-84387-1';
    if (!code.startsWith('#')) code = '#' + code;
    const title = params.get('title') || 'VIP Sessie - Vrijdag';
    const name = params.get('name') || 'Deon Draijer';
    const time = params.get('time') || '13:00 – 17:00 UUR';

    const tvSessionTitle = document.getElementById('tv-session-title');
    const tvName = document.getElementById('tv-name');
    const tvTime = document.getElementById('tv-time');
    const tvCode = document.getElementById('tv-code');
    const tvTicketCode = document.getElementById('tv-ticket-code');
    const tvDay = document.getElementById('tv-day');

    if (tvSessionTitle) tvSessionTitle.textContent = title.toUpperCase();
    if (tvName) tvName.textContent = name;
    if (tvTime) tvTime.textContent = time.toUpperCase();
    if (tvCode) tvCode.textContent = code;
    if (tvTicketCode) tvTicketCode.textContent = code;

    const titleLower = title.toLowerCase();
    if (titleLower.includes('vrijdag')) {
      if (tvDay) tvDay.textContent = '13';
    } else if (titleLower.includes('zondag')) {
      if (tvDay) tvDay.textContent = '15';
    } else {
      if (tvDay) tvDay.textContent = '14';
    }
  </script>
</body>
</html>
