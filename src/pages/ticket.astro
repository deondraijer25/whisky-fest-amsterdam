---
// src/pages/ticket.astro - Officiële Digitale E-Ticket Pass
import '../styles/global.css';
---

<!DOCTYPE html>
<html lang="nl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Digitaal E-Ticket | Whisky Fest Amsterdam</title>
  <meta name="robots" content="noindex, nofollow">
  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@600;700;800;900&family=Playfair+Display:ital,wght@0,600;0,700;0,800;1,600&family=Plus+Jakarta+Sans:wght@500;600;700;800&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://use.typekit.net/ppq2zvf.css">
  
  <!-- html2pdf.js for client-side PDF export on button click -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>

  <style>
    :root {
      --bg-body: #171514;
      --bg-card: #FAF7F2;
      --text-dark: #1D1C1A;
      --whisky-gold: #C58B39;
      --whisky-gold-dark: #8C6E46;
      --brand-red: #E30613;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      background-color: var(--bg-body);
      background-image: 
        radial-gradient(circle at 15% 20%, rgba(197, 139, 57, 0.12) 0%, transparent 40%),
        radial-gradient(circle at 85% 80%, rgba(227, 6, 19, 0.08) 0%, transparent 45%);
      font-family: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 2.5rem 1rem;
      color: #FFF;
    }

    .ticket-container-wrapper {
      width: 100%;
      max-width: 820px;
      display: flex;
      flex-direction: column;
      gap: 1.5rem;
    }

    /* Top bar with festival name & instant actions */
    .ticket-top-nav {
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 1rem;
      padding: 0 0.25rem;
    }

    .ticket-brand-badge {
      display: inline-flex;
      align-items: center;
      gap: 0.6rem;
      font-family: 'Cinzel', serif;
      font-weight: 700;
      font-size: 1.05rem;
      letter-spacing: 0.06em;
      color: var(--whisky-gold);
    }

    .ticket-btn-group {
      display: flex;
      gap: 0.75rem;
    }

    .btn-ticket-primary {
      background: var(--brand-red);
      color: #FFF;
      border: 2px solid #000;
      padding: 0.7rem 1.4rem;
      font-family: 'Plus Jakarta Sans', sans-serif;
      font-weight: 800;
      font-size: 0.88rem;
      border-radius: 4px;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      box-shadow: 3px 3px 0px #000;
      transition: all 0.2s ease;
      text-decoration: none;
    }

    .btn-ticket-primary:hover {
      transform: translateY(-2px);
      box-shadow: 4px 4px 0px #000;
      filter: brightness(1.1);
    }

    .btn-ticket-secondary {
      background: #FAF7F2;
      color: #1D1C1A;
      border: 2px solid #000;
      padding: 0.7rem 1.2rem;
      font-family: 'Plus Jakarta Sans', sans-serif;
      font-weight: 800;
      font-size: 0.88rem;
      border-radius: 4px;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      box-shadow: 3px 3px 0px #000;
      transition: all 0.2s ease;
      text-decoration: none;
    }

    .btn-ticket-secondary:hover {
      transform: translateY(-2px);
      box-shadow: 4px 4px 0px #000;
      background: #FFF;
    }

    /* DIGITAL E-TICKET CARD */
    .digital-ticket-card {
      background-color: var(--bg-card);
      border: 3px solid #1D1C1A;
      border-radius: 6px;
      box-shadow: 0 25px 60px rgba(0, 0, 0, 0.7), 8px 8px 0px #000;
      position: relative;
      overflow: hidden;
      display: flex;
      flex-direction: row;
      min-height: 310px;
      color: var(--text-dark);
    }

    /* Scanner stub (Left on desktop, bottom on mobile) */
    .ticket-scanner-stub {
      width: 230px;
      background-color: #F3EDE3;
      border-right: 2px dashed #1D1C1A;
      padding: 2rem 1.25rem;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: space-between;
      text-align: center;
      flex-shrink: 0;
    }

    .scanner-top-lbl {
      font-size: 0.72rem;
      font-weight: 800;
      letter-spacing: 0.12em;
      color: #6E685F;
      text-transform: uppercase;
    }

    .qr-frame {
      background: #FFFFFF;
      padding: 0.65rem;
      border: 2px solid #1D1C1A;
      border-radius: 4px;
      box-shadow: 2px 2px 0px #1D1C1A;
    }

    .scanner-inst {
      font-size: 0.78rem;
      font-weight: 800;
      color: #1D1C1A;
      letter-spacing: 0.05em;
      margin-top: 0.5rem;
    }

    .scanner-code-hash {
      font-family: monospace;
      font-size: 0.88rem;
      font-weight: 800;
      color: var(--brand-red);
    }

    /* Main ticket information */
    .ticket-main-section {
      flex-grow: 1;
      padding: 2.25rem 2.5rem;
      position: relative;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      overflow: hidden;
    }

    .watermark-overlay {
      position: absolute;
      right: 1.5rem;
      top: 50%;
      transform: translateY(-50%);
      font-family: 'Cinzel', serif;
      font-size: 14rem;
      color: rgba(197, 139, 57, 0.07);
      line-height: 1;
      pointer-events: none;
      user-select: none;
      font-weight: 900;
    }

    .ticket-header-block {
      display: flex;
      align-items: center;
      gap: 1.25rem;
    }

    .ticket-badge-date {
      background-color: #1D1C1A;
      color: #FAF7F2;
      border-radius: 4px;
      padding: 0.5rem 0.85rem;
      text-align: center;
      display: flex;
      flex-direction: column;
      line-height: 1;
      flex-shrink: 0;
    }

    .badge-month {
      font-size: 0.7rem;
      font-weight: 800;
      letter-spacing: 0.1em;
    }

    .badge-day {
      font-family: 'Cinzel', serif;
      font-size: 1.65rem;
      font-weight: 700;
      margin-top: 0.2rem;
    }

    .ticket-org-block {
      display: flex;
      flex-direction: column;
    }

    .org-est-text {
      font-size: 0.7rem;
      font-weight: 800;
      color: var(--whisky-gold-dark);
      letter-spacing: 0.1em;
      text-transform: uppercase;
    }

    .org-main-name {
      font-family: 'Cinzel', serif;
      font-size: 1.4rem;
      font-weight: 800;
      color: #1D1C1A;
      line-height: 1.2;
    }

    .org-loc-text {
      font-size: 0.82rem;
      color: #6E685F;
    }

    .ticket-dash-line {
      height: 1px;
      background: repeating-linear-gradient(90deg, #D5C28A 0, #D5C28A 6px, transparent 6px, transparent 12px);
      margin: 1.25rem 0;
    }

    .ticket-title-display {
      font-family: 'Playfair Display', serif;
      font-size: 1.85rem;
      font-weight: 700;
      color: #1D1C1A;
      margin-bottom: 1.25rem;
      line-height: 1.2;
    }

    .ticket-grid-fields {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 1.15rem 1.5rem;
    }

    .field-item {
      display: flex;
      flex-direction: column;
      gap: 0.15rem;
    }

    .field-label {
      font-size: 0.68rem;
      font-weight: 800;
      color: #6E685F;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .field-value {
      font-size: 1.02rem;
      font-weight: 700;
      color: #1D1C1A;
    }

    .ticket-footer-disclaimer {
      margin-top: 1.5rem;
      border-top: 1px solid #E8E0D2;
      padding-top: 0.75rem;
      font-size: 0.76rem;
      color: #6E685F;
      font-style: italic;
    }

    .ticket-bottom-tip {
      text-align: center;
      font-size: 0.85rem;
      color: rgba(255, 255, 255, 0.65);
    }

    @media (max-width: 768px) {
      .digital-ticket-card {
        flex-direction: column-reverse;
      }
      .ticket-scanner-stub {
        width: 100%;
        border-right: none;
        border-top: 2px dashed #1D1C1A;
        padding: 1.75rem 1.25rem;
      }
      .ticket-grid-fields {
        grid-template-columns: 1fr;
      }
      .ticket-main-section {
        padding: 1.75rem 1.5rem;
      }
    }

    @media print {
      body {
        background: #FFF !important;
        padding: 0 !important;
      }
      .ticket-top-nav, .ticket-bottom-tip {
        display: none !important;
      }
      .digital-ticket-card {
        box-shadow: none !important;
        border: 2px solid #000 !important;
        page-break-inside: avoid;
        margin: 0 auto !important;
        width: 100% !important;
        max-width: 100% !important;
      }
    }
  </style>
</head>
<body>
  <div class="ticket-container-wrapper">
    <!-- Top Action Bar -->
    <div class="ticket-top-nav">
      <div class="ticket-brand-badge">
        <span>🥃 Whisky Fest Amsterdam</span>
      </div>
      <div class="ticket-btn-group">
        <button type="button" class="btn-ticket-primary" onclick="downloadPdfDirect()">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
            <polyline points="7 10 12 15 17 10"/>
            <line x1="12" y1="15" x2="12" y2="3"/>
          </svg>
          Open / Download PDF
        </button>
        <button type="button" class="btn-ticket-secondary" onclick="window.print()">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="6 9 6 2 18 2 18 9"/>
            <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/>
            <rect x="6" y="14" width="12" height="8"/>
          </svg>
          Printen
        </button>
      </div>
    </div>

    <!-- Official Digital E-Ticket Card -->
    <div class="digital-ticket-card" id="ticket-capture-card">
      <!-- QR Code & Scanner Stub -->
      <div class="ticket-scanner-stub">
        <span class="scanner-top-lbl">CONTROLE STUB</span>

        <div class="qr-frame">
          <svg width="120" height="120" viewBox="0 0 100 100" style="shape-rendering: crispedges; display:block;">
            <path d="M0,0 h30 v10 h-20 v20 h-10 z" fill="#1D1C1A"/>
            <path d="M10,10 h10 v10 h-10 z" fill="#1D1C1A"/>
            <path d="M70,0 h30 v30 h-10 v-20 h-20 z" fill="#1D1C1A"/>
            <path d="M80,10 h10 v10 h-10 z" fill="#1D1C1A"/>
            <path d="M0,70 h10 v20 h20 v10 h-30 z" fill="#1D1C1A"/>
            <path d="M10,80 h10 v10 h-10 z" fill="#1D1C1A"/>
            <path d="M45,45 h10 v10 h-10 z" fill="#E30613"/>
            <path d="M30,30 h10 v5 h-10 z M35,40 h15 v5 h-15 z M55,30 h10 v10 h-5 v-5 h-5 z" fill="#1D1C1A"/>
            <path d="M70,70 h30 v10 h-10 v10 h-20 z M80,80 h10 v10 h-10 z" fill="#1D1C1A"/>
            <path d="M40,65 h10 v10 h-10 z M55,60 h10 v5 h-10 z M60,75 h5 v15 h-5 z" fill="#1D1C1A"/>
            <path d="M65,45 h10 v5 h-10 z M30,55 h5 v15 h-5 z M45,85 h10 v5 h-10 z" fill="#1D1C1A"/>
          </svg>
        </div>

        <div>
          <p class="scanner-inst">SCAN BIJ DE DEUR</p>
          <p class="scanner-code-hash" id="tv-code">#WF-2026-84387-1</p>
        </div>
      </div>

      <!-- Main Ticket Body -->
      <div class="ticket-main-section">
        <div class="watermark-overlay">WF</div>

        <div class="ticket-header-block">
          <div class="ticket-badge-date">
            <span class="badge-month" id="tv-month">NOV</span>
            <span class="badge-day" id="tv-day">13</span>
          </div>
          <div class="ticket-org-block">
            <span class="org-est-text">Est. 2004</span>
            <span class="org-main-name">Whisky Fest Amsterdam</span>
            <span class="org-loc-text">De Kromhouthal Amsterdam</span>
          </div>
        </div>

        <div class="ticket-dash-line"></div>

        <h1 class="ticket-title-display" id="tv-session-title">VIP Sessie - Vrijdag</h1>

        <div class="ticket-grid-fields">
          <div class="field-item">
            <span class="field-label">Kaarthouder:</span>
            <strong class="field-value" id="tv-name">Deon Draijer</strong>
          </div>
          <div class="field-item">
            <span class="field-label">Status:</span>
            <strong class="field-value" style="color: #1e6b48;">✓ GELDIG TOEGANGSBEWIJS</strong>
          </div>
          <div class="field-item">
            <span class="field-label">Tijdslot:</span>
            <strong class="field-value" id="tv-time">13:00 - 17:00 UUR</strong>
          </div>
          <div class="field-item">
            <span class="field-label">Ticket Code:</span>
            <strong class="field-value" style="color: var(--brand-red);" id="tv-ticket-code">#WF-2026-84387-1</strong>
          </div>
        </div>

        <div class="ticket-footer-disclaimer">
          * Toegang 18+. Toon deze QR-code digitaal op uw mobiel of geprint bij Gedempt Hamerkanaal 231, 1021 KP Amsterdam.
        </div>
      </div>
    </div>

    <p class="ticket-bottom-tip">
      💡 U kunt dit e-ticket direct op uw telefoon bewaren of als PDF downloaden.
    </p>
  </div>

  <script>
    const params = new URLSearchParams(window.location.search);
    let code = params.get('id') || params.get('code') || 'WF-2026-84387-1';
    if (!code.startsWith('#')) code = '#' + code;
    const title = params.get('title') || 'VIP Sessie - Vrijdag';
    const name = params.get('name') || 'Deon Draijer';
    const time = params.get('time') || '13:00 - 17:00 UUR';

    const tvSessionTitle = document.getElementById('tv-session-title');
    const tvName = document.getElementById('tv-name');
    const tvTime = document.getElementById('tv-time');
    const tvCode = document.getElementById('tv-code');
    const tvTicketCode = document.getElementById('tv-ticket-code');
    const tvDay = document.getElementById('tv-day');

    if (tvSessionTitle) tvSessionTitle.textContent = title;
    if (tvName) tvName.textContent = name;
    if (tvTime) tvTime.textContent = time.toUpperCase();
    if (tvCode) tvCode.textContent = code;
    if (tvTicketCode) tvTicketCode.textContent = code;

    const titleLower = title.toLowerCase();
    if (titleLower.includes('vrijdag')) {
      if (tvDay) tvDay.textContent = '13';
    } else if (titleLower.includes('zondag')) {
      if (tvDay) tvDay.textContent = '15';
    } else {
      if (tvDay) tvDay.textContent = '14';
    }

    // Direct PDF generator on button click
    function downloadPdfDirect() {
      const element = document.getElementById('ticket-capture-card');
      const filename = `E-Ticket-${code.replace('#', '')}-${name.replace(/\s+/g, '_')}.pdf`;
      
      const opt = {
        margin: [10, 10, 10, 10],
        filename: filename,
        image: { type: 'jpeg', quality: 0.98 },
        html2canvas: { scale: 2, useCORS: true, letterRendering: true },
        jsPDF: { unit: 'mm', format: 'a4', orientation: 'landscape' }
      };

      if (typeof (window as any).html2pdf !== 'undefined') {
        (window as any).html2pdf().set(opt).from(element).save();
      } else {
        window.print();
      }
    }
  </script>
</body>
</html>
