---
// src/pages/standhouders.astro
// Interactieve Plattegrond & Standhouders voor Amsterdam Whisky Festival (De Hallen Studio 2)
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getStandhouders } from '../lib/ghl';

const exhibitors = await getStandhouders('amsterdam');
---

<Layout 
  title="Interactieve Plattegrond & Standhouders" 
  description="Navigeer door De Hallen Studio 2 met onze interactieve plattegrond. Zoek direct waar uw favoriete whiskymerken en standhouders zich bevinden op het Amsterdam Whisky Festival."
>
  <!-- Navigation Header -->
  <Header />

  <main class="standhouders-page-wrapper">
    <!-- Page Header -->
    <div class="page-title-section animate-fade-in">
      <span class="page-tag">Festival Gids 2027</span>
      <h1 class="page-title">Plattegrond &amp; Stands</h1>
      <div class="vintage-line"></div>
      <p class="page-subtitle">Verken De Hallen Studio 2, zoek uw favoriete merken en zie direct welke standhouder zich waar bevindt.</p>
    </div>

    <!-- Horizontal Search & Filters Bar -->
    <div class="search-filter-horizontal-bar vintage-frame animate-fade-in" style="animation-delay: 0.1s;">
      <div class="vintage-frame-inner horizontal-bar-inner">
        
        <div class="search-input-wrapper">
          <input type="text" id="exhibitor-search" class="form-control" placeholder="Zoek op standhouder, merk of zaal..." />
          <span class="search-icon-inside">
            <svg class="search-icon-svg" viewBox="0 0 24 24" width="16" height="16" stroke="var(--text-charcoal)" stroke-width="2.5" fill="none" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
          </span>
        </div>
        
        <div class="filter-buttons-row">
          <button type="button" class="filter-tab active" data-filter="all">Alle</button>
          <button type="button" class="filter-tab" data-filter="scotch">Schots</button>
          <button type="button" class="filter-tab" data-filter="dutch">Nederlands</button>
          <button type="button" class="filter-tab" data-filter="independent">Onafhankelijk</button>
          <button type="button" class="filter-tab" data-filter="world">Wereld</button>
          <button type="button" class="filter-tab" data-filter="catering">Food &amp; Catering</button>
        </div>

      </div>
    </div>

    <!-- Interactive Map & Detail Layout -->
    <div class="map-detail-layout animate-fade-in" style="animation-delay: 0.15s;">
      
      <!-- LEFT COLUMN: The Digital Vector Floor Plan Map of Studio 2 -->
      <div class="map-visual-container vintage-frame">
        <div class="vintage-frame-inner map-scroll-area">
          <div class="map-toolbar">
            <div class="toolbar-info">
              <span class="toolbar-title">Studio 2 &bull; De Hallen Amsterdam</span>
              <span class="toolbar-sub">19 Stands &bull; Centraal Proefeiland &bull; Looproute Foyer</span>
            </div>
            <div class="zoom-controls">
              <button type="button" class="zoom-btn" id="zoom-in" title="Inzoomen">＋</button>
              <button type="button" class="zoom-btn" id="zoom-out" title="Uitzoomen">－</button>
              <button type="button" class="zoom-btn" id="zoom-reset" title="Herstellen">Herstel</button>
            </div>
          </div>
          
          <div class="svg-zoom-wrapper" id="svg-zoom-target">
            <!-- 100% PURE DIGITAL VECTOR SVG MAP OF DE HALLEN STUDIO 2 -->
            <svg viewBox="0 0 980 540" class="studio2-svg-map" id="studio2-map">
              <defs>
                <pattern id="pillar-pattern" width="10" height="10" patternUnits="userSpaceOnUse">
                  <circle cx="5" cy="5" r="3" fill="#D5CCA9" />
                </pattern>
                
                <pattern id="floor-grid" width="20" height="20" patternUnits="userSpaceOnUse">
                  <path d="M 20 0 L 0 0 0 20" fill="none" stroke="rgba(140, 2, 35, 0.03)" stroke-width="1" />
                </pattern>
              </defs>

              <!-- Blueprint grid / transparent canvas -->
              <rect width="980" height="540" fill="transparent" />

              <!-- ============================================== -->
              <!-- EXTERIOR & CORRIDOR CONNECTIONS -->
              <!-- ============================================== -->
              <!-- Walking corridor from Foyer / Entrance (Left) -->
              <rect x="25" y="315" width="135" height="70" fill="#F4EFEA" stroke="var(--text-charcoal)" stroke-width="2" />
              <rect x="25" y="315" width="135" height="70" fill="url(#floor-grid)" />
              
              <!-- Directional flow arrows in corridor -->
              <path d="M 45 350 L 135 350 M 125 343 L 135 350 L 125 357" stroke="#8c0223" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" fill="none" />
              <text x="88" y="338" font-family="var(--font-sans)" font-size="10" font-weight="800" fill="#8c0223" text-anchor="middle">VANAF FOYER</text>
              <text x="88" y="372" font-family="var(--font-sans)" font-size="9" font-weight="700" fill="var(--text-muted)" text-anchor="middle">Studio 1 &amp; Keuken</text>

              <!-- North Passage / Emergency connection (Top) -->
              <rect x="490" y="28" width="80" height="42" fill="#F4EFEA" stroke="var(--text-charcoal)" stroke-width="1.8" stroke-dasharray="4 3" />
              <text x="530" y="46" font-family="var(--font-sans)" font-size="9" font-weight="800" fill="var(--text-muted)" text-anchor="middle">NOODUITGANG</text>
              <text x="530" y="58" font-family="var(--font-sans)" font-size="8.5" font-weight="700" fill="#8c0223" text-anchor="middle">Passage &nearr;</text>

              <!-- ============================================== -->
              <!-- STUDIO 2 VENUE OUTER WALLS (Architectural Contour) -->
              <!-- ============================================== -->
              <!-- Chamfered top-right corner for Stand 4 + alcove bottom step -->
              <path d="M 160 315 
                       L 160 70 
                       L 870 70 
                       L 925 125 
                       L 925 385 
                       L 670 385 
                       L 670 485 
                       L 310 485 
                       L 310 385 
                       L 160 385" 
                    fill="#FAF6F0" stroke="var(--text-charcoal)" stroke-width="2.5" stroke-linejoin="round" class="venue-outline" />

              <!-- Main Entrance Door Opening (Left Wall, y=315 to y=385) -->
              <line x1="160" y1="318" x2="160" y2="382" stroke="#FAF6F0" stroke-width="4" />
              <!-- Door swing arc -->
              <path d="M 160 325 A 50 50 0 0 1 205 365" fill="none" stroke="#8c0223" stroke-width="1.8" stroke-dasharray="3 3" />
              <text x="175" y="380" font-family="var(--font-sans)" font-size="9.5" font-weight="900" fill="#8c0223">INGANG &rarr;</text>

              <!-- North Exit Door Opening (Top Wall, x=500 to x=560) -->
              <line x1="505" y1="70" x2="555" y2="70" stroke="#FAF6F0" stroke-width="4" />

              <!-- Interior grid wash -->
              <path d="M 160 70 L 870 70 L 925 125 L 925 385 L 670 385 L 670 485 L 310 485 L 310 385 L 160 385 Z" fill="url(#floor-grid)" />

              <!-- Watermark Hall Identifier -->
              <text x="540" y="235" class="map-hall-watermark">STUDIO 2 &bull; DE HALLEN</text>

              <!-- Structural Pillars in De Hallen -->
              <g class="studio-pillars">
                <!-- Top Pillar Row -->
                <rect x="285" y="145" width="10" height="10" rx="2" class="hall-pillar" />
                <rect x="460" y="145" width="10" height="10" rx="2" class="hall-pillar" />
                <rect x="635" y="145" width="10" height="10" rx="2" class="hall-pillar" />
                <rect x="805" y="145" width="10" height="10" rx="2" class="hall-pillar" />

                <!-- Bottom Pillar Row -->
                <rect x="285" y="305" width="10" height="10" rx="2" class="hall-pillar" />
                <rect x="500" y="305" width="10" height="10" rx="2" class="hall-pillar" />
                <rect x="710" y="305" width="10" height="10" rx="2" class="hall-pillar" />
              </g>

              <!-- Zone Guideline Dashes for Alcove -->
              <line x1="310" y1="385" x2="670" y2="385" stroke="#E2D2C0" stroke-width="1.2" stroke-dasharray="4 4" />
              <text x="490" y="405" font-family="var(--font-serif)" font-size="11" font-style="italic" fill="var(--text-muted)" opacity="0.4" text-anchor="middle">Studio 2 Alcove Zone</text>

              <!-- ============================================== -->
              <!-- STANDS (19 PHYSICAL STANDS EXACT TO OFFICIAL LIST) -->
              <!-- ============================================== -->

              <!-- STAND 1: Left wall upper (4 tables vertical - Nog te verkopen) -->
              <g class="svg-stand" data-stand="1" title="Stand 1: Nog te verkopen">
                <rect x="175" y="85" width="45" height="96" rx="3" class="stand-box stand-available" />
                <!-- 4 tables dividers -->
                <line x1="175" y1="109" x2="220" y2="109" class="stand-divider" />
                <line x1="175" y1="133" x2="220" y2="133" class="stand-divider" />
                <line x1="175" y1="157" x2="220" y2="157" class="stand-divider" />
                <text x="197" y="139" class="stand-num">1</text>
              </g>

              <!-- STAND 2: Left wall lower (3 tables vertical - DAM dranken - Thalassa) -->
              <g class="svg-stand" data-stand="2" title="Stand 2: DAM dranken - Thalassa">
                <rect x="175" y="195" width="45" height="75" rx="3" class="stand-box" />
                <!-- 3 tables dividers -->
                <line x1="175" y1="220" x2="220" y2="220" class="stand-divider" />
                <line x1="175" y1="245" x2="220" y2="245" class="stand-divider" />
                <text x="197" y="238" class="stand-num">2</text>
              </g>

              <!-- STAND 3: Top wall (8 tables horizontal - De Monnik Dranken) -->
              <g class="svg-stand" data-stand="3" title="Stand 3: De Monnik Dranken (8 Tafels)">
                <rect x="245" y="85" width="224" height="45" rx="3" class="stand-box" />
                <!-- 8 tables dividers -->
                <line x1="273" y1="85" x2="273" y2="130" class="stand-divider" />
                <line x1="301" y1="85" x2="301" y2="130" class="stand-divider" />
                <line x1="329" y1="85" x2="329" y2="130" class="stand-divider" />
                <line x1="357" y1="85" x2="357" y2="130" class="stand-divider" />
                <line x1="385" y1="85" x2="385" y2="130" class="stand-divider" />
                <line x1="413" y1="85" x2="413" y2="130" class="stand-divider" />
                <line x1="441" y1="85" x2="441" y2="130" class="stand-divider" />
                <text x="357" y="113" class="stand-num">3</text>
              </g>

              <!-- STAND 4: Top-right angled corner (3 tables angled - Mitra) -->
              <g class="svg-stand" data-stand="4" title="Stand 4: Mitra Drankspeciaalzaken" transform="translate(865, 92) rotate(45)">
                <rect x="-10" y="-20" width="78" height="40" rx="3" class="stand-box" />
                <!-- 3 tables dividers -->
                <line x1="16" y1="-20" x2="16" y2="20" class="stand-divider" />
                <line x1="42" y1="-20" x2="42" y2="20" class="stand-divider" />
                <text x="29" y="6" class="stand-num">4</text>
              </g>

              <!-- STAND 5: Right wall vertical (6 tables vertical - Bresser & Timmer) -->
              <g class="svg-stand" data-stand="5" title="Stand 5: Bresser &amp; Timmer">
                <rect x="865" y="170" width="45" height="144" rx="3" class="stand-box" />
                <!-- 6 tables dividers -->
                <line x1="865" y1="194" x2="910" y2="194" class="stand-divider" />
                <line x1="865" y1="218" x2="910" y2="218" class="stand-divider" />
                <line x1="865" y1="242" x2="910" y2="242" class="stand-divider" />
                <line x1="865" y1="266" x2="910" y2="266" class="stand-divider" />
                <line x1="865" y1="290" x2="910" y2="290" class="stand-divider" />
                <text x="887" y="248" class="stand-num">5</text>
              </g>

              <!-- STAND 6: Bottom-right wall (5 tables horizontal - Whisky Import Nederland) -->
              <g class="svg-stand" data-stand="6" title="Stand 6: Whisky Import Nederland (WIN)">
                <rect x="725" y="325" width="130" height="45" rx="3" class="stand-box" />
                <!-- 5 tables dividers -->
                <line x1="751" y1="325" x2="751" y2="370" class="stand-divider" />
                <line x1="777" y1="325" x2="777" y2="370" class="stand-divider" />
                <line x1="803" y1="325" x2="803" y2="370" class="stand-divider" />
                <line x1="829" y1="325" x2="829" y2="370" class="stand-divider" />
                <text x="790" y="353" class="stand-num">6</text>
              </g>

              <!-- STAND 7: Bottom wall before alcove (2 tables horizontal - Nog te verkopen) -->
              <g class="svg-stand" data-stand="7" title="Stand 7: Nog te verkopen">
                <rect x="655" y="325" width="54" height="45" rx="3" class="stand-box stand-available" />
                <!-- 2 tables divider -->
                <line x1="682" y1="325" x2="682" y2="370" class="stand-divider" />
                <text x="682" y="353" class="stand-num">7</text>
              </g>

              <!-- STAND 8: Alcove step wall vertical (3 tables vertical - Nog te verkopen) -->
              <g class="svg-stand" data-stand="8" title="Stand 8: Nog te verkopen">
                <rect x="610" y="400" width="45" height="72" rx="3" class="stand-box stand-available" />
                <!-- 3 tables dividers -->
                <line x1="610" y1="424" x2="655" y2="424" class="stand-divider" />
                <line x1="610" y1="448" x2="655" y2="448" class="stand-divider" />
                <text x="632" y="442" class="stand-num">8</text>
              </g>

              <!-- STAND 9: Alcove bottom right (4 tables horizontal - Craft Spirits) -->
              <g class="svg-stand" data-stand="9" title="Stand 9: Craft Spirits">
                <rect x="485" y="425" width="108" height="45" rx="3" class="stand-box" />
                <!-- 4 tables dividers -->
                <line x1="512" y1="425" x2="512" y2="470" class="stand-divider" />
                <line x1="539" y1="425" x2="539" y2="470" class="stand-divider" />
                <line x1="566" y1="425" x2="566" y2="470" class="stand-divider" />
                <text x="539" y="453" class="stand-num">9</text>
              </g>

              <!-- STAND 10: Alcove bottom left (3 tables horizontal - Distilleerderij de Bronckhorst) -->
              <g class="svg-stand" data-stand="10" title="Stand 10: Distilleerderij de Bronckhorst">
                <rect x="385" y="425" width="84" height="45" rx="3" class="stand-box" />
                <!-- 3 tables dividers -->
                <line x1="413" y1="425" x2="413" y2="470" class="stand-divider" />
                <line x1="441" y1="425" x2="441" y2="470" class="stand-divider" />
                <text x="427" y="453" class="stand-num">10</text>
              </g>

              <!-- STAND 11: Alcove left vertical step (6 tables vertical - Van Weringhs Whisky World) -->
              <g class="svg-stand" data-stand="11" title="Stand 11: Van Weringhs Whisky World">
                <rect x="325" y="320" width="45" height="144" rx="3" class="stand-box" />
                <!-- 6 tables dividers -->
                <line x1="325" y1="344" x2="370" y2="344" class="stand-divider" />
                <line x1="325" y1="368" x2="370" y2="368" class="stand-divider" />
                <line x1="325" y1="392" x2="370" y2="392" class="stand-divider" />
                <line x1="325" y1="416" x2="370" y2="416" class="stand-divider" />
                <line x1="325" y1="440" x2="370" y2="440" class="stand-divider" />
                <text x="347" y="398" class="stand-num">11</text>
              </g>

              <!-- STAND 12: Angled near entrance door (2 tables angled - Dutch Whisky Teers) -->
              <g class="svg-stand" data-stand="12" title="Stand 12: Dutch Whisky Teers" transform="translate(210, 305) rotate(-20)">
                <rect x="0" y="0" width="54" height="42" rx="3" class="stand-box" />
                <!-- 2 tables divider -->
                <line x1="27" y1="0" x2="27" y2="42" class="stand-divider" />
                <text x="27" y="27" class="stand-num">12</text>
              </g>

              <!-- ============================================== -->
              <!-- CENTRAL ISLAND CLUSTER (ORGANISATIE + STANDS 15-20) -->
              <!-- ============================================== -->

              <!-- ORGANISATIE (Central Island Top-Left: 4 tables with (i) badge) -->
              <g class="svg-stand" data-stand="O" title="Organisatie stand (drams verkoop en informatie)">
                <rect x="485" y="165" width="108" height="45" rx="3" class="stand-box organisation" />
                <!-- 4 tables dividers -->
                <line x1="512" y1="165" x2="512" y2="210" class="stand-divider" />
                <line x1="539" y1="165" x2="539" y2="210" class="stand-divider" />
                <line x1="566" y1="165" x2="566" y2="210" class="stand-divider" />
                <circle cx="500" cy="187" r="7" fill="#8c0223" />
                <text x="500" y="190" font-family="var(--font-sans)" font-size="9" font-weight="900" fill="#FFFFFF" text-anchor="middle">i</text>
                <text x="548" y="192" class="stand-num text-bold" style="font-size: 8px; fill: #8c0223; letter-spacing: 0.12em;">ORGANISATIE</text>
              </g>

              <!-- STAND 15: Central Island Top-Middle (2 tables - International Whisky Society) -->
              <g class="svg-stand" data-stand="15" title="Stand 15: International Whisky Society">
                <rect x="610" y="165" width="54" height="45" rx="3" class="stand-box" />
                <!-- 2 tables divider -->
                <line x1="637" y1="165" x2="637" y2="210" class="stand-divider" />
                <text x="637" y="193" class="stand-num">15</text>
              </g>

              <!-- STAND 16: Central Island Top-Right (3 tables - Cane & Grain Slijterij) -->
              <g class="svg-stand" data-stand="16" title="Stand 16: Cane &amp; Grain Slijterij">
                <rect x="680" y="165" width="81" height="45" rx="3" class="stand-box" />
                <!-- 3 tables dividers -->
                <line x1="707" y1="165" x2="707" y2="210" class="stand-divider" />
                <line x1="734" y1="165" x2="734" y2="210" class="stand-divider" />
                <text x="720" y="193" class="stand-num">16</text>
              </g>

              <!-- STAND 17: Central Island Right Vertical (4 tables vertical - Brugse Whisky Company) -->
              <g class="svg-stand" data-stand="17" title="Stand 17: Brugse Whisky Company">
                <rect x="740" y="225" width="45" height="96" rx="3" class="stand-box" />
                <!-- 4 tables dividers -->
                <line x1="740" y1="249" x2="785" y2="249" class="stand-divider" />
                <line x1="740" y1="273" x2="785" y2="273" class="stand-divider" />
                <line x1="740" y1="297" x2="785" y2="297" class="stand-divider" />
                <text x="762" y="279" class="stand-num">17</text>
              </g>

              <!-- STAND 18: Central Island Bottom Right (5 tables horizontal - Nog te verkopen) -->
              <g class="svg-stand" data-stand="18" title="Stand 18: Nog te verkopen">
                <rect x="545" y="250" width="130" height="45" rx="3" class="stand-box stand-available" />
                <!-- 5 tables dividers -->
                <line x1="571" y1="250" x2="571" y2="295" class="stand-divider" />
                <line x1="597" y1="250" x2="597" y2="295" class="stand-divider" />
                <line x1="623" y1="250" x2="623" y2="295" class="stand-divider" />
                <line x1="649" y1="250" x2="649" y2="295" class="stand-divider" />
                <text x="610" y="278" class="stand-num">18</text>
              </g>

              <!-- STAND 19: Central Island Bottom Left (5 tables horizontal - Bacardi Martini) -->
              <g class="svg-stand" data-stand="19" title="Stand 19: Bacardi Martini">
                <rect x="395" y="250" width="130" height="45" rx="3" class="stand-box" />
                <!-- 5 tables dividers -->
                <line x1="421" y1="250" x2="421" y2="295" class="stand-divider" />
                <line x1="447" y1="250" x2="447" y2="295" class="stand-divider" />
                <line x1="473" y1="250" x2="473" y2="295" class="stand-divider" />
                <line x1="499" y1="250" x2="499" y2="295" class="stand-divider" />
                <text x="460" y="278" class="stand-num">19</text>
              </g>

              <!-- STAND 20: Central Island Left Vertical (3 tables vertical - Nog te verkopen) -->
              <g class="svg-stand" data-stand="20" title="Stand 20: Nog te verkopen">
                <rect x="335" y="165" width="45" height="75" rx="3" class="stand-box stand-available" />
                <!-- 3 tables dividers -->
                <line x1="335" y1="190" x2="380" y2="190" class="stand-divider" />
                <line x1="335" y1="215" x2="380" y2="215" class="stand-divider" />
                <text x="357" y="208" class="stand-num">20</text>
              </g>

            </svg>
          </div>
        </div>
      </div>
      
      <!-- RIGHT COLUMN: Stand Info Card -->
      <div class="sidebar-exhibitors-panel">
        
        <!-- Interactive Detail Card -->
        <div class="sidebar-card info-card-detail" id="stand-info-card">
          <div class="card-padded" id="default-info-state">
            <h3 class="card-inner-title text-center">Stand Detail</h3>
            <div class="vintage-line"></div>
            <p class="sidebar-card-text text-center italic-text">
              Klik op een standnummer op de plattegrond of kies een standhouder uit de lijst om de details, merken en zaallocatie te bekijken.
            </p>
          </div>
          
          <div class="card-padded" id="active-info-state" style="display: none;">
            <div class="detail-stand-badge-row">
              <span class="detail-stand-number" id="detail-number">Stand 1</span>
              <span class="status-badge" id="detail-category-badge">Schots</span>
            </div>
            
            <div class="detail-content-block">
              <h3 class="card-inner-title" id="detail-name">Standhouder Naam</h3>
              <div class="vintage-line" style="margin: 0.5rem 0 1rem 0;"></div>
              
              <div class="detail-hall-row" id="detail-hall-box" style="display: none;">
                <span class="hall-badge">
                  <svg class="hall-pin-svg" viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                    <circle cx="12" cy="10" r="3"></circle>
                  </svg>
                  <span id="detail-hall">Studio 2</span>
                </span>
              </div>

              <p class="sidebar-card-text" id="detail-description">
                Beschrijving van de standhouder.
              </p>
              
              <div class="detail-brands-box" id="detail-brands-box">
                <span class="brands-label">Aanwezige Merken:</span>
                <div class="brands-list-tags" id="detail-brands">
                  <!-- Dynamic brands go here -->
                </div>
              </div>
            </div>
          </div>
        </div>

      </div>
    </div>

    <!-- FULL DIRECTORY LIST BELOW -->
    <section class="directory-list-section">
      <div class="directory-section-header">
        <h2 class="directory-title">Deelnemerslijst (A-Z)</h2>
        <span class="results-counter" id="results-count">{exhibitors.length} standhouders gevonden</span>
      </div>
      
